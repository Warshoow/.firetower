{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "[ -x \"$HOME/.claude/hooks/big-read-gate.py\" ] || exit 0; exec \"$HOME/.claude/hooks/big-read-gate.py\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "command -v rtk >/dev/null || exit 0; exec rtk hook claude" },
          { "type": "command", "command": "[ -x \"$HOME/.claude/hooks/big-read-gate.py\" ] || exit 0; exec \"$HOME/.claude/hooks/big-read-gate.py\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "[ -x \"$HOME/.claude/hooks/context-watch.sh\" ] || exit 0; exec \"$HOME/.claude/hooks/context-watch.sh\"" }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "mattpocock-skills@mattpocock": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true
  },
  "extraKnownMarketplaces": {
    "ponytail": { "source": { "source": "github", "repo": "DietrichGebert/ponytail" } },
    "mattpocock": { "source": { "source": "github", "repo": "mattpocock/skills" } },
    "ui-ux-pro-max-skill": { "source": { "source": "github", "repo": "nextlevelbuilder/ui-ux-pro-max-skill" } }
  },
  "effortLevel": "high"
}
